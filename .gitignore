# Entorno virtual
venv/
.venv/

# Working copy of the report at the repo root (the committed copy lives in docs/).
/ai_radar_report.csv

# radar.db is committed on purpose (git-scraping): the snapshot history must
# persist between scheduled runs so momentum can be computed.
#
# docs/ is NOT tracked: it's the Vite build output. GitHub Pages is deployed
# from a CI artifact (see .github/workflows/radar.yml), so nobody commits it —
# this is what stops local builds from colliding with the bot's commits.
docs/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Node / Vite (React app in web/)
web/node_modules/
web/dist/
npm-debug.log*

# Generated data feeds (produced by `python -m ai_radar`; the committed copies
# live in docs/ after the Vite build).
web/public/data.json
web/public/ai_radar_report.csv

# VS Code
.vscode/

# Secretos
.env

# Claude Code local tooling config
.claude/
.impeccable/
